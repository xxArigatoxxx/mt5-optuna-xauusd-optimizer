    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def ensure_report_dirs(config: OptimizerConfig) -> None:
    relative_dir = Path(config.report_subdir)
    for root in [config.data_dir, config.terminal_exe.parent]:
        try:
            (root / relative_dir).mkdir(parents=True, exist_ok=True)
        except PermissionError:
            continue


def candidate_report_paths(config: OptimizerConfig, report_relative: str) -> list[Path]:
    relative = Path(report_relative)
    bases = [config.data_dir, config.terminal_exe.parent]
    names = [relative, relative.with_suffix(".htm"), relative.with_suffix(".html"), relative.with_suffix(".xml")]
    candidates: list[Path] = []
    for base in bases:
        for name in names:
            candidates.append(base / name)
    return candidates


def cleanup_report_candidates(paths: Iterable[Path]) -> None:
    for path in paths:
        if path.exists():
            path.unlink()


def cleanup_study_temp_artifacts(config: OptimizerConfig) -> int:
    patterns: list[tuple[Path, str]] = [
        (config.data_dir / "MQL5" / "Profiles" / "Tester", f"{config.study_name}_trial_*.set"),
        (config.work_dir, f"{config.study_name}_trial_*.ini"),
        (config.data_dir / Path(config.report_subdir), f"{config.study_name}_trial_*"),
        (config.terminal_exe.parent / Path(config.report_subdir), f"{config.study_name}_trial_*"),
    ]

    deleted_count = 0
    deleted_paths: set[Path] = set()

    for root, pattern in patterns:
        if not root.exists():
            continue
        for path in root.glob(pattern):
            if path in deleted_paths or not path.is_file():
                continue
            try:
                path.unlink()
                deleted_paths.add(path)
                deleted_count += 1
            except OSError:
                continue

    return deleted_count


