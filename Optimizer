    parser.add_argument("--apply-best-to-base-set", action="store_true", help="Overwrite the base .set file with the best eligible trial.")
    parser.add_argument("--apply-best-to-source-defaults", action="store_true", help="Rewrite optimized input defaults into the EA .mq5 source and compile it.")
    parser.add_argument("--apply-best-min-win-rate", type=float, default=50.0, help="Minimum best-trial win rate %% required before auto-apply runs.")
    parser.add_argument("--w-profit-dd", type=float, default=0.60, help="Weight for NetProfit/MaxDrawdown term.")
