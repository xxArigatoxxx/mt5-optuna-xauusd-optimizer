    parser.add_argument("--seed", type=int, default=42)
    parser.add_argument("--storage", default=f"sqlite:///{DEFAULT_STORAGE.as_posix()}")
    parser.add_argument("--report-subdir", default=r"reports\optuna")
    parser.add_argument("--portable", action="store_true", help="Use /portable when launching terminal64.exe")
    parser.add_argument("--min-trades", type=int, default=40, help="Minimum Total Trades required for a valid trial.")
    parser.add_argument("--min-win-rate", type=float, default=48.0, help="Minimum Win Rate %% required for a valid trial.")
