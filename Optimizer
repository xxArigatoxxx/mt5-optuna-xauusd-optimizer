def parse_metric_pairs_from_rows(rows: list[list[str]]) -> tuple[dict[str, float], dict[str, str]]:
    metrics_num: dict[str, float] = {}
    metrics_text: dict[str, str] = {}
    for row in rows:
        cells = [normalize_space(cell) for cell in row if normalize_space(cell)]
        for i in range(len(cells) - 1):
            label = normalize_label(cells[i])
            value_text = cells[i + 1]
            if not label:
                continue
            if re.search(r"[a-z]", label):
                metrics_text.setdefault(label, value_text)
                value = first_number(value_text)
                if value is not None:
                    metrics_num.setdefault(label, value)
    return metrics_num, metrics_text


def extract_total_trades_fallback(report_text: str) -> int | None:
    patterns = [
        r"Total Trades:\s*</td>\s*<td[^>]*>\s*<b>\s*([0-9][0-9, ]*)\s*</b>",
        r"Total Trades:\s*([0-9][0-9, ]*)",
        r"<td[^>]*>\s*Total Trades:\s*</td>\s*<td[^>]*>\s*([0-9][0-9, ]*)\s*</td>",
    ]
    for pattern in patterns:
        match = re.search(pattern, report_text, flags=re.IGNORECASE)
        if not match:
            continue
        token = match.group(1).replace(",", "").replace(" ", "")
        try:
            return int(token)
        except ValueError:
            continue
    return None


def parse_html_report(path: Path) -> tuple[dict[str, float], dict[str, str]]:
    parser = SimpleTableParser()
    report_text = read_text_auto(path)
    parser.feed(report_text)
    metrics_num, metrics_text = parse_metric_pairs_from_rows(parser.rows)

    total_trades = lookup_metric(metrics_num, LABEL_ALIASES["total_trades"])
    if total_trades is None:
        fallback_total_trades = extract_total_trades_fallback(report_text)
        if fallback_total_trades is not None:
            metrics_num["total trades"] = float(fallback_total_trades)
            metrics_text["total trades"] = str(fallback_total_trades)

    return metrics_num, metrics_text


def parse_xml_report(path: Path) -> tuple[dict[str, float], dict[str, str]]:
    report_text = read_text_auto(path)
    root = ET.fromstring(report_text)
    texts = []
    for elem in root.iter():
        text = normalize_space(elem.text or "")
        if text:
            texts.append(text)
    rows = [[texts[i], texts[i + 1]] for i in range(0, max(0, len(texts) - 1), 2)]
    metrics_num, metrics_text = parse_metric_pairs_from_rows(rows)

    total_trades = lookup_metric(metrics_num, LABEL_ALIASES["total_trades"])
    if total_trades is None:
        fallback_total_trades = extract_total_trades_fallback(report_text)
        if fallback_total_trades is not None:
            metrics_num["total trades"] = float(fallback_total_trades)
            metrics_text["total trades"] = str(fallback_total_trades)

    return metrics_num, metrics_text


def lookup_metric(metric_map: dict[str, float], aliases: list[str]) -> float | None:
    normalized_aliases = [normalize_label(alias) for alias in aliases]
    for alias in normalized_aliases:
        if alias in metric_map:
            return metric_map[alias]
    for label, value in metric_map.items():
        if any(alias in label for alias in normalized_aliases):
            return value
    return None


def lookup_metric_text(metric_map: dict[str, str], aliases: list[str]) -> str | None:
    normalized_aliases = [normalize_label(alias) for alias in aliases]
    for alias in normalized_aliases:
        if alias in metric_map:
            return metric_map[alias]
    for label, value in metric_map.items():
        if any(alias in label for alias in normalized_aliases):
            return value
    return None


def parse_report(report_path: Path) -> BacktestMetrics:
    if not report_path.exists():
        raise FileNotFoundError(f"Report not found: {report_path}")

    suffix = report_path.suffix.lower()
    if suffix == ".xml":
        metric_num, metric_text = parse_xml_report(report_path)
    else:
        metric_num, metric_text = parse_html_report(report_path)

    net_profit = lookup_metric(metric_num, LABEL_ALIASES["net_profit"])
    balance_dd = lookup_metric(metric_num, LABEL_ALIASES["balance_drawdown"])
    equity_dd = lookup_metric(metric_num, LABEL_ALIASES["equity_drawdown"])
    profit_factor = lookup_metric(metric_num, LABEL_ALIASES["profit_factor"]) or 0.0
    sharpe_ratio = lookup_metric(metric_num, LABEL_ALIASES["sharpe_ratio"]) or 0.0
    total_trades = lookup_metric(metric_num, LABEL_ALIASES["total_trades"])

    if net_profit is None:
        raise ValueError(f"Could not find Net Profit in report: {report_path}")

    drawdown_candidates = [value for value in [balance_dd, equity_dd] if value is not None]
    if not drawdown_candidates:
        raise ValueError(f"Could not find Max Drawdown in report: {report_path}")

    if total_trades is None:
        raise ValueError(f"Could not find Total Trades in report: {report_path}")

    win_rate_text = lookup_metric_text(metric_text, LABEL_ALIASES["win_rate"]) or ""
    win_rate_pct = first_percent(win_rate_text)
    if win_rate_pct is None:
        fallback_win = lookup_metric(metric_num, LABEL_ALIASES["win_rate"])
        if fallback_win is not None and 0.0 <= fallback_win <= 100.0:
            win_rate_pct = fallback_win
        else:
            win_rate_pct = 0.0

    return BacktestMetrics(
        net_profit=net_profit,
        max_drawdown=max(drawdown_candidates),
        profit_factor=profit_factor,
        sharpe_ratio=sharpe_ratio,
        win_rate=win_rate_pct,
        total_trades=int(round(total_trades)),
    )


def wait_for_report(config: OptimizerConfig, report_relative: str, started_at: float) -> Path:
    deadline = time.time() + 15.0
    candidates = candidate_report_paths(config, report_relative)
    while time.time() < deadline:
        for candidate in candidates:
            if candidate.exists() and candidate.stat().st_mtime >= started_at - 1:
                return candidate
        time.sleep(0.5)
    raise FileNotFoundError(
        "Tester finished but no report was found. Checked:\n"
        + "\n".join(f"  - {path}" for path in candidates)
    )


def terminate_process_tree(pid: int) -> None:
    subprocess.run(
        ["taskkill", "/PID", str(pid), "/T", "/F"],
        check=False,
        capture_output=True,
        text=True,
    )


def list_running_terminal_pids(executable_path: Path) -> list[int]:
    cmd = (
        "Get-CimInstance Win32_Process -Filter \"Name = 'terminal64.exe'\" | "
        "Select-Object ProcessId,ExecutablePath | ConvertTo-Json -Compress"
    )
    result = subprocess.run(
        ["powershell", "-NoProfile", "-Command", cmd],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return []

    import json

    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError:
        return []

    records = payload if isinstance(payload, list) else [payload]
    target = str(executable_path).lower()
    pids: list[int] = []
    for record in records:
        path = str(record.get("ExecutablePath") or "").lower()
        pid = record.get("ProcessId")
        if path == target and isinstance(pid, int):
            pids.append(pid)
    return pids


def ensure_terminal_not_running(config: OptimizerConfig) -> None:
    pids = list_running_terminal_pids(config.terminal_exe)
    if not pids:
        return

    if config.force_close_existing:
        for pid in pids:
            terminate_process_tree(pid)
        time.sleep(2.0)
        return

    raise RuntimeError(
        "An MT5 terminal from the same installation is already running.\n"
        "Close it first, or rerun with --force-close-existing.\n"
        f"Terminal: {config.terminal_exe}\n"
        f"PIDs: {pids}"
    )


def compute_fitness(metrics: BacktestMetrics, config: OptimizerConfig) -> tuple[float, dict[str, float]]:
    profit_dd_ratio = metrics.net_profit / (metrics.max_drawdown + 0.01)
    trade_frequency_target = max(float(config.min_total_trades), 1.0)
    win_rate_baseline = max(float(config.min_win_rate), 1.0)
    trade_frequency_factor = metrics.total_trades / trade_frequency_target
    win_rate_factor = max(metrics.win_rate, config.min_win_rate) / win_rate_baseline
    m15_score = profit_dd_ratio * trade_frequency_factor * win_rate_factor

    if config.require_profit_gt_drawdown and metrics.max_drawdown > 0 and metrics.net_profit <= metrics.max_drawdown:
        return -10_000.0 + m15_score, {
            "profit_dd_ratio": profit_dd_ratio,
            "win_rate_factor": win_rate_factor,
            "trade_frequency_factor": trade_frequency_factor,
            "m15_score": m15_score,
        }

    return m15_score, {
        "profit_dd_ratio": profit_dd_ratio,
        "win_rate_factor": win_rate_factor,
        "trade_frequency_factor": trade_frequency_factor,
        "m15_score": m15_score,
    }


