    parser.add_argument("--w-win-rate", type=float, default=0.05, help="Weight for Win Rate term ((WR-50)/50).")
    parser.set_defaults(force_close_existing=True)
    parser.add_argument(
        "--force-close-existing",
        dest="force_close_existing",
        action="store_true",
        help="Force-close an already running terminal64.exe from the same installation before each trial (default: ON).",
    )
    parser.add_argument(
        "--no-force-close-existing",
