def validate_config(config: OptimizerConfig) -> None:
    if not config.terminal_exe.exists():
        raise FileNotFoundError(f"terminal64.exe not found: {config.terminal_exe}")
    if not config.data_dir.exists():
        raise FileNotFoundError(f"MT5 data directory not found: {config.data_dir}")
    if not (config.data_dir / "MQL5" / "Experts").exists():
        raise FileNotFoundError(
            f"MT5 data directory does not look valid: {config.data_dir}"
        )
    if config.portable and "Program Files" in str(config.terminal_exe):
        print(
            "WARNING: /portable is usually not recommended for terminals installed in Program Files.\n"
            "Leave it off unless you intentionally run a portable installation.",
            file=sys.stderr,
        )
    if config.min_total_trades < 1:
        raise ValueError("--min-trades must be at least 1.")
    if config.min_win_rate <= 0.0 or config.min_win_rate > 100.0:
        raise ValueError("--min-win-rate must be inside (0, 100].")
    if config.min_ml_source_rows < 0:
        raise ValueError("--min-ml-source-rows must be zero or greater.")
    if config.apply_best_min_win_rate <= 0.0 or config.apply_best_min_win_rate > 100.0:
        raise ValueError("--apply-best-min-win-rate must be inside (0, 100].")


def main() -> None:
    config = parse_args()
    validate_config(config)

    sampler = optuna.samplers.TPESampler(seed=config.seed)
    study = optuna.create_study(
        study_name=config.study_name,
        direction="maximize",
        sampler=sampler,
        storage=config.storage,
        load_if_exists=True,
    )

    print(f"Study      : {config.study_name}")
    print(f"Terminal   : {config.terminal_exe}")
    print(f"Data dir   : {config.data_dir}")
    print(f"Expert     : {config.expert_relative_path}")
    print(f"Symbol/TF  : {config.symbol} / {config.period}")
    print(f"Date range : {config.from_date} -> {config.to_date}")
    print(f"Trials     : {config.n_trials}")
    print(f"Storage    : {config.storage}")
    print(f"Min trades : {config.min_total_trades}")
    print(f"Min win %%  : {config.min_win_rate:.1f}")
    _, ml_policy_status = prepare_base_inputs(config)
    print(f"ML assist  : {ml_policy_status}")
    print(
        "Fitness    : (net_profit / (max_drawdown + 0.01)) * "
        f"(total_trades / {config.min_total_trades}) * max(win_rate, {config.min_win_rate:.1f}) / {config.min_win_rate:.1f}"
    )
    if config.apply_best_to_base_set or config.apply_best_to_source_defaults:
        print(
            "Auto-apply : "
            f"base_set={'ON' if config.apply_best_to_base_set else 'OFF'} "
            f"source={'ON' if config.apply_best_to_source_defaults else 'OFF'} "
            f"threshold={config.apply_best_min_win_rate:.1f}%"
        )
    print(
        "Constraint : profit must be greater than drawdown"
        if config.require_profit_gt_drawdown
        else "Constraint : profit may be below drawdown"
    )
    print()

    study.optimize(
        make_objective(config),
        n_trials=config.n_trials,
        catch=(TimeoutError, FileNotFoundError, ValueError, RuntimeError),
    )

    completed_trials = [
        trial for trial in study.trials
        if trial.state == optuna.trial.TrialState.COMPLETE
    ]
    if not completed_trials:
        print("\nNo completed trials. Check MT5 logs/report path and try again.")
        return

    best = study.best_trial
    eligible_trials = [
        trial for trial in completed_trials
        if (trial.user_attrs.get("total_trades") or 0) >= config.min_total_trades
        and (trial.user_attrs.get("win_rate") or 0.0) >= config.min_win_rate
        and trial.value is not None
        and trial.value > -999.0
    ]
    best_set_paths: list[Path] = []
    if eligible_trials:
        best = max(eligible_trials, key=lambda trial: float(trial.value))
        best_set_paths = export_best_set(config, best)

        auto_apply_targets: list[str] = []
        best_win_rate = float(best.user_attrs.get("win_rate") or 0.0)
        if best_win_rate >= config.apply_best_min_win_rate:
            if config.apply_best_to_base_set:
                applied_set = apply_best_to_base_set_file(config, best)
                if applied_set is not None:
                    auto_apply_targets.append(f"base set -> {applied_set}")
            if config.apply_best_to_source_defaults:
                source_path, compile_log = apply_best_to_source_defaults(config, best)
                auto_apply_targets.append(f"EA source -> {source_path}")
                auto_apply_targets.append(f"compile log -> {compile_log}")
        elif config.apply_best_to_base_set or config.apply_best_to_source_defaults:
            print(
                "\nAuto-apply skipped because the best eligible trial win rate "
                f"{best_win_rate:.2f}% is below the apply threshold {config.apply_best_min_win_rate:.2f}%."
            )
    else:
        print("\nBEST.set not exported because no trial reached the minimum trade requirement.")

    print("\nBest trial")
    print(f"  number      = {best.number}")
    print(f"  fitness     = {best.value:.6f}")
    print(f"  net_profit  = {best.user_attrs.get('net_profit')}")
    print(f"  max_dd      = {best.user_attrs.get('max_drawdown')}")
    print(f"  total_trades= {best.user_attrs.get('total_trades')}")
    print(f"  profit_fact = {best.user_attrs.get('profit_factor')}")
    print(f"  sharpe      = {best.user_attrs.get('sharpe_ratio')}")
    print(f"  win_rate    = {best.user_attrs.get('win_rate')}")
    print(f"  report_path = {best.user_attrs.get('report_path')}")
    print("  params:")
    for key, value in best.params.items():
        print(f"    {key} = {value}")

    if eligible_trials and 'auto_apply_targets' in locals() and auto_apply_targets:
        print("  auto_apply:")
        for target in auto_apply_targets:
            print(f"    {target}")

    trials_csv = config.work_dir / f"{config.study_name}_trials.csv"
    export_trials_csv(study, trials_csv)
    results_excel = export_trials_results_excel(study, Path.cwd() / f"{config.study_name}_results.xlsx")
    print(f"\nTrials CSV  : {trials_csv}")
    print(f"Results XLSX: {results_excel}")
    for path in best_set_paths:
        print(f"BEST set    : {path}")

    deleted_temp_files = cleanup_study_temp_artifacts(config)
    print(f"Temp cleanup: deleted {deleted_temp_files} old trial artifact(s)")


if __name__ == "__main__":
    main()
