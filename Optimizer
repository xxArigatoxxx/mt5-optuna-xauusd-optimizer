    parser.add_argument("--terminal-exe", type=Path, default=DEFAULT_TERMINAL)
    parser.add_argument("--data-dir", type=Path, default=DEFAULT_DATA_DIR)
    parser.add_argument("--expert", default=DEFAULT_EXPERT)
    parser.add_argument("--base-set", type=Path, default=DEFAULT_BASE_SET)
    parser.add_argument("--work-dir", type=Path, default=DEFAULT_WORK_DIR)
    parser.add_argument("--template", type=Path, default=DEFAULT_TEMPLATE)
    parser.add_argument("--symbol", default="GOLD")
    parser.add_argument("--period", default="M15")
    parser.add_argument("--from-date", default="2025.01.01")
    parser.add_argument("--to-date", default="2026.03.20")
