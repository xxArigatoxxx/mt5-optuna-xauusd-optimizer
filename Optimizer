class SimpleTableParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.rows: list[list[str]] = []
        self._current_row: list[str] = []
        self._current_cell: list[str] = []
        self._in_cell = False

    def handle_starttag(self, tag: str, attrs) -> None:
        if tag == "tr":
            self._current_row = []
        elif tag in {"td", "th"}:
            self._in_cell = True
            self._current_cell = []

    def handle_endtag(self, tag: str) -> None:
        if tag in {"td", "th"}:
            text = normalize_space("".join(self._current_cell))
            self._current_row.append(text)
            self._in_cell = False
        elif tag == "tr":
            row = [cell for cell in self._current_row if cell]
            if row:
                self.rows.append(row)
            self._current_row = []

    def handle_data(self, data: str) -> None:
        if self._in_cell:
            self._current_cell.append(data)


def normalize_space(text: str) -> str:
    return re.sub(r"\s+", " ", html.unescape(text)).strip()


def normalize_label(text: str) -> str:
    text = normalize_space(text).lower()
    return re.sub(r"[^a-z0-9% ]+", "", text)


def first_number(text: str) -> float | None:
    match = re.search(r"[-+]?\d[\d, ]*(?:\.\d+)?", text)
    if not match:
        return None
    token = match.group(0).replace(",", "").replace(" ", "")
    try:
        return float(token)
    except ValueError:
        return None


def first_percent(text: str) -> float | None:
    match = re.search(r"\(([-+]?\d+(?:\.\d+)?)\s*%\)", text)
    if match:
        try:
            return float(match.group(1))
        except ValueError:
            return None

    match = re.search(r"([-+]?\d+(?:\.\d+)?)\s*%", text)
    if match:
        try:
            return float(match.group(1))
        except ValueError:
            return None
    return None


def read_text_auto(path: Path) -> str:
    raw = path.read_bytes()
    if raw.startswith(b"\xff\xfe") or raw.startswith(b"\xfe\xff"):
        return raw.decode("utf-16")
    if raw.startswith(b"\xef\xbb\xbf"):
        return raw.decode("utf-8-sig")
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return raw.decode("cp1252", errors="replace")


def common_files_dir(data_dir: Path) -> Path:
    return data_dir.parent / "Common" / "Files"


def parse_bool_text(value: str) -> bool:
    return str(value).strip().lower() in {"1", "true", "yes", "on"}


def parse_key_value_file(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values

    for raw_line in read_text_auto(path).splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or line.startswith(";") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip()
    return values


def resolve_ml_config_path(data_dir: Path, ml_config_value: str) -> Path:
    candidate = Path(ml_config_value)
    if candidate.is_absolute():
        return candidate
    return common_files_dir(data_dir) / candidate.name


def parse_minutes(text: str) -> int:
    match = re.match(r"^\s*(\d{1,2}):(\d{2})\s*$", str(text))
    if not match:
        raise ValueError(f"Invalid HH:MM time: {text}")
    hour = int(match.group(1))
    minute = int(match.group(2))
    return (hour * 60) + minute


def session_hours_from_inputs(inputs: dict[str, str]) -> set[int]:
    start_text = inputs.get("InpSessionStart", "00:00")
    end_text = inputs.get("InpSessionEnd", "23:59")
    start_min = parse_minutes(start_text)
    end_min = parse_minutes(end_text)

    hours: set[int] = set()
    for hour in range(24):
        hour_start = hour * 60
        hour_end = hour_start + 60
        if start_min < end_min:
            if max(start_min, hour_start) < min(end_min, hour_end):
                hours.add(hour)
        else:
            if max(start_min, hour_start) < min(1440, hour_end):
                hours.add(hour)
            if max(0, hour_start) < min(end_min, hour_end):
                hours.add(hour)
    return hours


def parse_allowed_hours_csv(value: str) -> set[int]:
    hours: set[int] = set()
    for token in str(value).split(","):
        token = token.strip()
        if not token:
            continue
        try:
            hour = int(token)
        except ValueError:
            continue
        if 0 <= hour <= 23:
            hours.add(hour)
    return hours


def apply_ml_optimizer_policy(
    inputs: dict[str, str],
    data_dir: Path,
    min_ml_source_rows: int,
) -> tuple[dict[str, str], str]:
    resolved = dict(inputs)
    resolved["InpMlConfigFile"] = resolved.get("InpMlConfigFile", DEFAULT_ML_CONFIG_FILE) or DEFAULT_ML_CONFIG_FILE

    if not parse_bool_text(resolved.get("InpUseMlAdaptiveConfig", "false")):
        return resolved, "OFF (disabled by base inputs)"

    ml_config_path = resolve_ml_config_path(data_dir, resolved["InpMlConfigFile"])
    ml_config = parse_key_value_file(ml_config_path)
    if not ml_config:
        resolved["InpUseMlAdaptiveConfig"] = "false"
        return resolved, f"OFF (config not found: {ml_config_path.name})"

    try:
        source_rows = int(float(ml_config.get("source_rows", "0") or 0))
    except ValueError:
        source_rows = 0

    if source_rows < min_ml_source_rows:
        resolved["InpUseMlAdaptiveConfig"] = "false"
        return resolved, f"OFF (source_rows {source_rows} < {min_ml_source_rows})"

    allowed_hours = parse_allowed_hours_csv(ml_config.get("allowed_hours", ""))
    session_hours = session_hours_from_inputs(resolved)
    if allowed_hours and session_hours and allowed_hours.isdisjoint(session_hours):
        resolved["InpUseMlAdaptiveConfig"] = "false"
        return (
            resolved,
            "OFF (ML allowed_hours "
            + ",".join(str(hour) for hour in sorted(allowed_hours))
            + " do not overlap session)",
        )

    resolved["InpUseMlAdaptiveConfig"] = "true"
    resolved["InpUseHourFilter"] = "true"
    return resolved, f"ON (source_rows {source_rows}, config {ml_config_path.name})"


